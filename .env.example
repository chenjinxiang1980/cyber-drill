# ==============================================================================
# 演练系统 · 环境变量模板
# ==============================================================================
# 1) 复制本文件为 .env（不要提交 .env 到仓库）
# 2) 替换所有 __REPLACE_WITH__ 占位符为实际值
# 3) 路径均相对于项目根目录；可以使用绝对路径
# ==============================================================================

# -------- 运行环境 --------
APP_ENV=development
HTTP_ADDR=0.0.0.0:8090
# 部署后前端访问的对外 URL（用于安全链接生成、邮件等），例如 https://drill.example.com
# 留空则回退到 http://localhost:<HTTP_ADDR>
PUBLIC_BASE_URL=

# -------- MySQL --------
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drill_system
# 业务账号（必须是 MySQL 存在的真实账号；不要用 root 跑生产）
DB_USER=__REPLACE_WITH_DB_USER__
DB_PASSWORD=__REPLACE_WITH_DB_PASSWORD__
DB_SSLMODE=disable

# -------- MySQL Root / Bootstrap 凭据 --------
# 仅 bootstrap（建库建账号 DDL）需要；服务启动不读取。
# 优先使用 DB_ROOT_USER / DB_ROOT_PASSWORD；未设置则回退到 DB_USER / DB_PASSWORD；
# 再未设置就默认 root / 空（本机无密码 root 连接场景）。
DB_ROOT_USER=root
DB_ROOT_PASSWORD=

# -------- 账号清理白名单 --------
# 服务端硬校验的基线账号（逗号分隔、不含 admin；admin 永远保留）。
# 留空时仅保留 admin。开源仓库不内置任何真实账号清单。
ADMIN_BASELINE_USERS=

# -------- JWT --------
# 用 openssl rand -hex 32 生成
JWT_SECRET=__REPLACE_WITH_JWT_SECRET__
# token 有效期（分钟）
JWT_TTL=480

# -------- Session --------
# 用 openssl rand -hex 32 生成
SESSION_SECRET=__REPLACE_WITH_SESSION_SECRET__

# -------- HTTPS / TLS（可选，生产强烈建议开启） --------
# 开启后：
#   - HTTPS_CERT_FILE / HTTPS_KEY_FILE 必须指向存在的证书和私钥
#   - 证书缺失会直接拒绝启动，不会静默降级
#   - 同时起 HTTP 301 跳转（见 HTTP_REDIRECT_TO_HTTPS）
TLS_ENABLED=false
TLS_ADDR=:8443
HTTPS_CERT_FILE=deploy/certs/server.crt
HTTPS_KEY_FILE=deploy/certs/server.key
HTTP_REDIRECT_TO_HTTPS=false

# -------- 上传与数据目录 --------
UPLOAD_ROOT=uploads
UPLOAD_MAX_MB=20
DATA_DIR=data

# -------- 接口限流（每分钟）--------
RATE_LIMIT_GLOBAL=300        # 仅 /api/*；/public/*、/uploads/* 不受限
RATE_LIMIT_AUTH=30           # /api/auth/login 专用分组限流；必须严格小于 GLOBAL

# -------- 登录失败锁定 --------
LOGIN_MAX_FAILURES=5         # 同一 username 连续密码错误达到 N 次触发锁定
LOGIN_LOCK_MINUTES=15        # 锁定持续分钟数；期间返回 423 + 剩余分钟

# -------- 登录验证码（SVG 算术题，内存存储）--------
CAPTCHA_ENABLED=true         # 关闭后登录忽略 captchaId/captchaCode（内部测试用）
CAPTCHA_TTL_SECONDS=120      # 验证码有效期秒数（默认 120）；一次性使用

# -------- CORS --------
ALLOW_ORIGINS=*
# ALLOW_ORIGINS=https://drill.example.com,https://admin.example.com

# -------- 可信代理（Gin 用）--------
# 反向代理场景下，填写代理内网 IP 段，使 client real IP 取 X-Forwarded-For
TRUSTED_PROXIES=
