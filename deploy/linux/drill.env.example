# ==============================================================================
# drill-server · Linux 部署环境变量模板
# ==============================================================================
# 使用：
#   # 物理机 / systemd
#   sudo cp drill.env.example /etc/drill/drill.env
#   sudo vi /etc/drill/drill.env
#   sudo chmod 0640 /etc/drill/drill.env
#
#   # Docker Compose（VMware VM 推荐）
#   cp drill.env.example .env
#   vi .env
#   # 改 DB_HOST=mysql（compose 内部 DNS，写死不要动）
#   # 改 APP_HOST_PORT（VMware NAT 两阶段见 README-FIRST.md）
#
# 所有 __REPLACE_WITH__ 占位符必须替换为真实值，仓库里 **零真实凭据**。
# 关于路径：
#   - 二进制用 -root=/opt/drill 启动，所以相对路径都是相对于 /opt/drill 解析。
#   - TLS_* 证书路径默认 /etc/drill/certs，install.sh 会创建该目录。
#
# 默认值说明：
#   DB_HOST=mysql        —— Compose 内部容器名（DNS 自动解析）
#                           物理机 systemd 部署改 DB_HOST=127.0.0.1 或远程 IP
#   APP_HOST_PORT=8090   —— 默认宿主端口
#                           VMware NAT 阶段一改 8091，阶段二（停掉旧 Go）再改回 8090
# ==============================================================================

# -------- 运行环境 --------
APP_ENV=production
HTTP_ADDR=0.0.0.0:8090
# 部署后对外访问的 URL，例如 https://drill.example.com
# 留空则回退到 http://localhost:<HTTP_ADDR>
PUBLIC_BASE_URL=__REPLACE_WITH_PUBLIC_BASE_URL__

# -------- Docker Compose 宿主端口映射 --------
# compose.yml 里 ports 段 ${APP_HOST_PORT:-8090}:8090 读取此值
# VMware NAT 场景两阶段用法：
#   阶段一（Windows 宿主 8090 被旧 Go 服务占用）：APP_HOST_PORT=8091
#     → vmnetnat.conf 里 [incomingtcp] 加 8091 = <VM-IP>:8090
#     → 局域网访问 http://<宿主IP>:8091
#   阶段二（停掉 Windows Go 后）：APP_HOST_PORT=8090（或删掉这行，默认就是 8090）
#     → vmnetnat.conf 改回 8090 = <VM-IP>:8090
#     → 局域网访问 http://<宿主IP>:8090
APP_HOST_PORT=8090

# -------- MySQL --------
# Compose 内部（默认）: DB_HOST=mysql（容器名，compose DNS 解析）
# 物理机 MySQL:         DB_HOST=127.0.0.1 或远程 IP
DB_HOST=mysql
DB_PORT=3306
DB_NAME=drill_system
# 业务账号（必须是 MySQL 真实存在的账号；不要用 root 跑生产）
# Compose 场景下这个值必须和 docker-compose.yml 里 MYSQL_USER / MYSQL_PASSWORD 完全一致
DB_USER=__REPLACE_WITH_DB_USER__
DB_PASSWORD=__REPLACE_WITH_DB_PASSWORD__
DB_SSLMODE=disable

# -------- MySQL Root / Bootstrap 凭据 --------
# 仅首次 bootstrap（建库建账号 DDL）需要；服务启动不读取。
# Compose 场景下这个值必须和 docker-compose.yml 里 MYSQL_ROOT_PASSWORD 完全一致
DB_ROOT_USER=root
DB_ROOT_PASSWORD=__REPLACE_WITH_DB_ROOT_PASSWORD__

# -------- JWT --------
# openssl rand -hex 32 生成
JWT_SECRET=__REPLACE_WITH_JWT_SECRET__
# token 有效期（分钟）
JWT_TTL=480

# -------- Session --------
# openssl rand -hex 32 生成
SESSION_SECRET=__REPLACE_WITH_SESSION_SECRET__

# -------- HTTPS / TLS（可选，反向代理已处理 TLS 时可关闭）--------
# 说明：如果你用 Nginx/Caddy 做 HTTPS 卸载（通常推荐），这里保持
# TLS_ENABLED=false，让 Go 进程只监听明文 HTTP（localhost:8090）。
# 只有在**没有任何反向代理、直接对外暴露**时才开 TLS。
TLS_ENABLED=false
TLS_ADDR=:8443
# 证书放 /etc/drill/certs/，需 drill 用户可读（见 install.sh 提示）
HTTPS_CERT_FILE=/etc/drill/certs/server.crt
HTTPS_KEY_FILE=/etc/drill/certs/server.key
HTTP_REDIRECT_TO_HTTPS=false

# -------- 上传与数据目录（相对 /opt/drill 解析）--------
UPLOAD_ROOT=uploads
# 注意：Nginx/Caddy 的 client_max_body_size 也要同步改成这个值
UPLOAD_MAX_MB=20
DATA_DIR=data

# -------- 接口限流（每分钟）--------
RATE_LIMIT_GLOBAL=300        # 仅 /api/*；/public/*、/uploads/* 不受限
RATE_LIMIT_AUTH=30           # /api/auth/login 专用分组限流；必须 < GLOBAL

# -------- 登录失败锁定 --------
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# -------- 登录验证码（内存存储）--------
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=120

# -------- CORS --------
# 默认同源部署，保持为空（不发送任何 CORS 响应头）；确需跨域时写死明确来源，禁止 *
# ALLOW_ORIGINS=https://drill.example.com,https://admin.example.com
ALLOW_ORIGINS=

# -------- 可信代理（Gin 用）--------
# 反向代理场景填写代理内网 IP 段（CIDR），使 ClientIP 取 X-Forwarded-For
# Nginx 在同机 → TRUSTED_PROXIES=127.0.0.1/32
# Nginx 在 10.0.0.5 → TRUSTED_PROXIES=10.0.0.5/32
# 多层代理 → 逗号分隔: 127.0.0.1/32,10.0.0.0/24
# 容器 Compose → 172.17.0.0/16 或直接用容器网段
TRUSTED_PROXIES=__REPLACE_WITH_TRUSTED_PROXIES__
