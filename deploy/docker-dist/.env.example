# =============================================================================
# Drill System —— 环境变量模板（零真实值）
#
# 使用方法：
#   cp .env.example .env
#   # 然后编辑 .env —— 所有 __REPLACE_WITH__ 占位符必须替换成真实值
#
# 安全提醒：
#   本模板不内置任何默认密钥/密码。任何情况下不得把真实凭据提交到 Git。
#   .env 文件应加 .gitignore，部署时通过安全通道分发（Ansible / Vault / Sops 等）。
# =============================================================================

# ---------- 基本 ----------
APP_ENV=production
# 构建/镜像版本（compose 用它作为 build arg 与镜像 tag）
VERSION=0.5.1
# HTTP 监听地址。compose 会通过 environment 段覆盖成 0.0.0.0:8090，
# 这里保留作单容器 docker run 时的默认值。
HTTP_ADDR=0.0.0.0:8090
# 对外访问基础 URL（用于邮件、回调、登录 redirect 等场景）
# 部署到 HTTPS 反向代理后应改成 https://your-domain.com
PUBLIC_BASE_URL=http://localhost:8090

# ---------- 账号清理白名单 ----------
# 服务端硬校验的基线账号（逗号分隔、不含 admin；admin 永远保留）。
# 留空时仅保留 admin。开源仓库不内置任何真实账号清单。
ADMIN_BASELINE_USERS=

# ---------- MySQL ----------
# DB_HOST 在 compose 内由 environment 段强制覆盖为 mysql（内部 DNS）。
# 这里仅作单容器跑 drill-migrate / 本地开发用。
DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=drill_system
# 业务账号（与 compose 里 MYSQL_USER 保持一致）
DB_USER=__REPLACE_WITH_DB_USER__
# 业务账号密码（与 compose 里 MYSQL_PASSWORD 保持一致，**不能为空**）
DB_PASSWORD=__REPLACE_WITH_DB_PASSWORD__
DB_SSLMODE=disable
# MySQL root 密码（compose 里 MYSQL_ROOT_PASSWORD，仅 bootstrap 子命令
# 或手动干预时需要。drill-server 本身不需要 root 权限）
MYSQL_ROOT_PASSWORD=__REPLACE_WITH_ROOT_PW__

# ---------- 密钥（必须替换，否则应用启动时 os.Exit(2)）-----------
# 生成命令：openssl rand -hex 32 （或 xxd -l 32 -p /dev/urandom）
JWT_SECRET=__REPLACE_WITH_HEX32_JWT_SECRET__
SESSION_SECRET=__REPLACE_WITH_HEX32_SESSION_SECRET__

# ---------- 管理员初始密码 ----------
# 首次部署创建管理员账号用（通过 bootstrap 子命令）。
# 如果跳过 bootstrap（compose 里已自动跑 migrations），此项可留空；
# 也可以部署后用 /api/admin/reset 接口重置。
ADMIN_INIT_PASSWORD=__REPLACE_WITH_STRONG_ADMIN_PASSWORD__

# ---------- 上传 ----------
UPLOAD_MAX_MB=20

# ---------- 限流 ----------
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_AUTH=30

# ---------- 登录失败锁定 ----------
LOGIN_MAX_FAILURES=5
LOGIN_LOCK_MINUTES=15

# ---------- 验证码 ----------
CAPTCHA_ENABLED=true
CAPTCHA_TTL_SECONDS=120

# ---------- HTTPS/TLS（可选，默认关闭）----------
# 启用前请确保证书文件已挂载到容器内对应路径
TLS_ENABLED=false
TLS_ADDR=:8443
HTTPS_CERT_FILE=
HTTPS_KEY_FILE=
HTTP_REDIRECT_TO_HTTPS=false

# ---------- CORS ----------
ALLOW_ORIGINS=*

# ---------- 可信代理 ----------
# Gin 用，转发 X-Forwarded-For 时信任的网段
TRUSTED_PROXIES=172.17.0.0/16,127.0.0.1/32
