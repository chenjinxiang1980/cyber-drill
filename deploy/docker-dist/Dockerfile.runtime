# =============================================================================
# Dockerfile.runtime —— 轻量冒烟用（只有 runtime 阶段，不依赖 golang 镜像）
#
# 用法（远程 Linux 上）：
#   DOCKER_BUILDKIT=1 docker build \
#       --build-arg HTTP_PROXY=http://<代理地址>:7890 \
#       --build-arg HTTPS_PROXY=http://<代理地址>:7890 \
#       -f deploy/docker-dist/Dockerfile.runtime -t drill-server:0.8.6-smoke .
#
# 假设：构建上下文根目录下有：
#   dist_local/drill-server   dist_local/drill-migrate  （本地交叉编译好的 ELF）
#   public/                    （前端静态资源）
#   migrations/                （建表 SQL）
#   deploy/docker-dist/docker-entrypoint.sh
#
# =============================================================================

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY=localhost,127.0.0.1

FROM alpine:3.20

ARG HTTP_PROXY
ARG HTTPS_PROXY
ARG NO_PROXY
ENV HTTP_PROXY=${HTTP_PROXY}
ENV HTTPS_PROXY=${HTTPS_PROXY}
ENV NO_PROXY=${NO_PROXY}

ENV TZ=Asia/Shanghai
ENV APP_ROOT=/opt/drill

# apk add 运行时依赖（mariadb-client 提供 mysqldump / mysql 客户端，备份恢复必需）
RUN apk add --no-cache tini wget ca-certificates tzdata mariadb-client \
 && cp /usr/share/zoneinfo/Asia/Shanghai /etc/localtime \
 && echo "Asia/Shanghai" > /etc/timezone \
 && addgroup -S -g 10001 drill \
 && adduser  -S -u 10001 -G drill -h /opt/drill -s /sbin/nologin drill \
 && echo "[runtime] apk OK"

# 目录
RUN mkdir -p /opt/drill/bin \
              /opt/drill/public \
              /opt/drill/migrations \
              /opt/drill/data \
              /opt/drill/uploads \
              /opt/drill/etc \
 && chown -R drill:drill /opt/drill

WORKDIR /opt/drill

# ELF（已交叉编译好）—— dist_local 目录必须存在，其中 drill-server 必需；
# drill-migrate / drill-seed 存在则打包，缺失则跳过（entrypoint 会 warn 后继续启动）。
# 本地可直接用 scripts/build-linux.ps1 一次性产出三个二进制到 server/deploy-linux/。
COPY dist_local/ /tmp/dist/
RUN cp /tmp/dist/drill-server /opt/drill/bin/drill-server \
 && (test -f /tmp/dist/drill-migrate && cp /tmp/dist/drill-migrate /opt/drill/bin/drill-migrate || true) \
 && (test -f /tmp/dist/drill-seed    && cp /tmp/dist/drill-seed    /opt/drill/bin/drill-seed    || true) \
 && rm -rf /tmp/dist

# 静态资源 + 迁移脚本
COPY public/          /opt/drill/public/
COPY migrations/      /opt/drill/migrations/

# entrypoint
COPY deploy/docker-dist/docker-entrypoint.sh /opt/drill/docker-entrypoint.sh

# 权限 + 可选二进制存在性保护（缺 migrate/seed 不影响 server 运行，entrypoint 会跳过）
RUN chown -R drill:drill /opt/drill \
 && chmod 755 /opt/drill/bin/drill-server \
 && (test -f /opt/drill/bin/drill-migrate && chmod 755 /opt/drill/bin/drill-migrate || true) \
 && (test -f /opt/drill/bin/drill-seed    && chmod 755 /opt/drill/bin/drill-seed    || true) \
 && chmod 755 /opt/drill/docker-entrypoint.sh \
 && chmod 644 /opt/drill/public/*           2>/dev/null || true \
 && chmod 644 /opt/drill/public/img/*       2>/dev/null || true \
 && chmod 644 /opt/drill/migrations/*.sql   2>/dev/null || true \
 && echo "[runtime] permissions OK"

# 容器内运行时代理清空（默认不设）
ENV HTTP_PROXY=
ENV HTTPS_PROXY=

EXPOSE 8090

HEALTHCHECK --interval=30s --timeout=5s --start-period=20s --retries=3 \
    CMD wget -qO- http://127.0.0.1:8090/api/health || exit 1

USER drill:drill

# tini 作为 init：正确转发 SIGTERM 给子进程
# entrypoint.sh 等 MySQL → 跑 migrations（若 migrate 存在）→ exec drill-server
ENTRYPOINT ["/sbin/tini", "--", "/opt/drill/docker-entrypoint.sh"]
CMD ["/opt/drill/bin/drill-server", "-root=/opt/drill"]
