# 统一行尾，避免 Windows 侧 core.autocrlf 把脚本写成 CRLF
* text=auto

# Linux 上执行的脚本必须 LF：CRLF 会让 shebang 变成 "#!/bin/sh\r"，容器内 tini
# 报 "exec ... failed: No such file or directory"
*.sh text eol=lf
docker-entrypoint* text eol=lf
Dockerfile text eol=lf
Dockerfile.* text eol=lf

# 源码与 SQL 统一 LF
*.go text eol=lf
*.sql text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf
*.mod text eol=lf
*.sum text eol=lf
# 发布签名文件必须保持 LF（9 行校验格式）
*.sha256.txt text eol=lf

# Windows 侧脚本保持 CRLF
*.ps1 text eol=crlf
*.psm1 text eol=crlf
*.bat text eol=crlf
*.cmd text eol=crlf

# 二进制不要做文本转换
*.png binary
*.jpg binary
*.ico binary
*.gz binary
*.zip binary
*.db binary
